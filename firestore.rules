rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*admin_.*') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Users collection (Admin has full control to create, read, update, and delete)
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 2. Staff / Faculty collection
    match /staff/{staffId} {
      allow read, write: if isAuthenticated();
    }

    match /teachers/{teacherId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Students collection
    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Subjects collection (Curricular Subjects across 1st, 3rd, 4th, 5th Semesters)
    match /subjects/{subjectId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Teaching Assignments (Admin maps Faculty to Semester + Subject)
    match /teachingAssignments/{assignmentId} {
      allow read, write: if isAuthenticated();
    }

    match /teaching_assignments/{assignmentId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Classes collection
    match /classes/{classId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Assignments collection
    match /assignments/{assignmentId} {
      allow read, write: if isAuthenticated();
    }

    // 8. Submissions collection (Google Drive link submissions & marks evaluation)
    match /submissions/{submissionId} {
      allow read, write: if isAuthenticated();
    }

    // 9. Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
  }
}
