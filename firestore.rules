rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || request.auth.token.admin == true);
    }

    function isStaff() {
      return isAuthenticated() && (getUserRole() == 'staff' || getUserRole() == 'teacher');
    }

    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Admin can create or update any user; owner can update profile if not changing role
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow update: if isAuthenticated() && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    // 2. Staff / Teachers collection
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isOwner(teacherId);
    }

    // 3. Students collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 4. Subjects collection
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 5. Teaching Assignments collection (Admin maps Staff -> Semester + Subject)
    match /teachingAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 6. Classes collection
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isStaff() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdmin() || (isStaff() && resource.data.teacherId == request.auth.uid);
    }

    // 7. Assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isStaff() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isAdmin() || (isStaff() && resource.data.teacherId == request.auth.uid);
    }

    // 8. Submissions collection
    match /submissions/{submissionId} {
      // Students can read ONLY their own submissions
      // Teachers can read submissions for their assigned classes
      // Admin can view all
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid || 
        resource.data.teacherId == request.auth.uid
      );

      // Student creates submission (cannot set marks)
      allow create: if isStudent() && 
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.marks == null;

      // Student can update their submission driveLink (cannot modify marks)
      // Teacher can grade (set marks and feedback)
      // Admin can update if needed
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isStudent() && resource.data.studentId == request.auth.uid && request.resource.data.marks == resource.data.marks) ||
        (isStaff() && resource.data.teacherId == request.auth.uid)
      );

      allow delete: if isAdmin();
    }

    // 9. Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
    }
  }
}
